#version 450
#extension GL_GOOGLE_include_directive : require
// The generated frame at time t: each pixel the previous frame at -t*v blended with the current one at +(1-t)*v.
// v is chosen here per frame pixel, from the picked vectors of the 2x2 working pixels around it, as the one the two
// frames agree on best at the pixel (ties to its own working pixel's): a working pixel is up to 4x4 frame pixels, and
// on an object's edge its one vector is wrong for the side it isn't of, which took the other side's colour, a band of
// the background around the object. Where no vector makes the two agree (what one frame can't see: uncovered behind a
// moving object, or about to be covered by one), a blend would show both, a ghost: of the two, the one nearer to the
// pixel as it is in the nearer frame is taken. A cut (the frames don't match as a whole) gets no blend: the nearer
// frame as it is.
//   a.xy  frame size      a.zw  working size      b.x  scale (frame pixels per working pixel)
//   c.xy  1 / frame size      c.z  t      c.w  the mean difference above which it's a cut
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D prv;
layout(set = 0, binding = 1) uniform sampler2D cur;
layout(set = 0, binding = 2) uniform sampler2D pix;
layout(set = 0, binding = 3) uniform sampler2D stat;
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D outp;
#define OWN_BIAS 0.02   /* a neighbour's vector replaces the pixel's own only when it agrees better by this */
#define LO 0.06         /* disagreement (mean of |r|,|g|,|b|) where the blend starts giving way to one side, and */
#define HI 0.16         /* where it has */
float diff(vec3 x, vec3 y) { vec3 d = abs(x - y); return (d.r + d.g + d.b) * (1.0 / 3.0); }
void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (p.x >= u.a.x || p.y >= u.a.y) return;
	float t = u.c.z; vec2 uv = (vec2(p) + 0.5) * u.c.xy;
	if (texelFetch(stat, ivec2(0), 0).r > u.c.w) { imageStore(outp, p, vec4((t < 0.5 ? textureLod(prv, uv, 0.0) : textureLod(cur, uv, 0.0)).rgb, 1.0)); return; }
	float s = float(u.b.x); ivec2 hi = u.a.zw - 1, own = clamp(p / u.b.x, ivec2(0), hi);
	ivec2 q0 = ivec2(floor((vec2(p) + 0.5) / s - 0.5));   /* the 2x2 working pixels whose centres surround this one (its own among them) */
	vec2 to_uv = s * u.c.xy;
	vec2 v = texelFetch(pix, own, 0).xy * to_uv;
	vec3 a = textureLod(prv, uv - t * v, 0.0).rgb, c = textureLod(cur, uv + (1.0 - t) * v, 0.0).rgb;
	float e = diff(a, c), m = e - OWN_BIAS;   /* (m: what a neighbour's must beat) */
	for (int k = 0; k < 4; k++) {
		ivec2 q = clamp(q0 + ivec2(k & 1, k >> 1), ivec2(0), hi);
		if (q == own) continue;
		vec2 w = texelFetch(pix, q, 0).xy * to_uv;
		if (w == v) continue;
		vec3 a2 = textureLod(prv, uv - t * w, 0.0).rgb, c2 = textureLod(cur, uv + (1.0 - t) * w, 0.0).rgb;
		float e2 = diff(a2, c2);
		if (e2 < m) { e = m = e2; a = a2; c = c2; }
	}
	vec3 o = mix(a, c, t);
	if (e > LO) {
		vec3 r = t < 0.5 ? textureLod(prv, uv, 0.0).rgb : textureLod(cur, uv, 0.0).rgb;
		o = mix(o, diff(a, r) <= diff(c, r) ? a : c, smoothstep(LO, HI, e));
	}
	imageStore(outp, p, vec4(o, 1.0));
}
