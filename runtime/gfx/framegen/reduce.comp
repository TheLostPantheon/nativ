#version 450
#extension GL_GOOGLE_include_directive : require
// A frame's luma at the working size, or a luma level halved: each output pixel the mean of its scale x scale source
// pixels, read as bilinear taps on the corners between them (each a 2x2 mean).
//   a.xy  output size      a.z  scale (1, or even)      a.w  1: the source is colour, 0: luma
//   c.xy  1 / source size
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 1, binding = 0, r16f) uniform writeonly image2D dst;
void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (p.x >= u.a.x || p.y >= u.a.y) return;
	int s = u.a.z; float acc = 0.0, n = 0.0;
	if (s == 1) { vec4 c = texelFetch(src, p, 0); acc = u.a.w != 0 ? luma(c.rgb) : c.r; n = 1.0; }
	else for (int j = 0; j < s; j += 2) for (int i = 0; i < s; i += 2) {
		vec4 c = textureLod(src, (vec2(p * s + ivec2(i, j)) + 1.0) * u.c.xy, 0.0);
		acc += u.a.w != 0 ? luma(c.rgb) : c.r; n += 1.0;
	}
	imageStore(dst, p, vec4(acc / n));
}
